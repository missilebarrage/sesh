# CurseForge / BigWigs packager configuration.
package-as: Sesh

# The addon lives in Sesh/ inside the repository; this moves its contents to the top of the
# package (and removes the then-empty inner folder).
move-folders:
  Sesh/Sesh: Sesh

ignore:
  - tests
  - scripts
  - docs
  - stylua.toml

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
